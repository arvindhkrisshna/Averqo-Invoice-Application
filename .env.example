# Copy to .env (never commit .env) and replace every value.
DB_NAME=averqo
DB_USER=averqo
DB_PASSWORD=change-me-to-a-long-random-password
MYSQL_ROOT_PASSWORD=change-me-too-another-long-password
# Needed once, to create the owner account on the setup page.
SETUP_CODE=change-me-a-code-only-you-know
# Keep these when Averqo is behind an HTTPS proxy.
COOKIE_SECURE=true
TRUST_PROXY=1
