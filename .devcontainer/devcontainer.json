{
  "name": "Invoice app (Angular + Go + MySQL)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },

  "forwardPorts": [4200, 8080],
  "portsAttributes": {
    "4200": { "label": "Invoice app (Angular)", "onAutoForward": "openBrowser" },
    "8080": { "label": "API (Go)", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "angular.ng-template"]
    }
  }
}
